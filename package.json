{
    "name": "opencode-autorecord",
    "version": "1.0.10",
    "description": "OpenCode plugin - automatically save conversation records to markdown files",
    "type": "module",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "default": "./dist/index.js"
        }
    },
    "files": [
        "dist"
    ],
    "bin": {
        "opencode-autorecord": "./dist/cli.js"
    },
    "scripts": {
        "build": "tsup",
        "lint": "eslint src --ext .ts",
        "typecheck": "tsc --noEmit",
        "prepublishOnly": "npm run build"
    },
    "keywords": [
        "opencode",
        "plugin",
        "conversation",
        "backup",
        "markdown",
        "autorecord"
    ],
    "author": "vc",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/kevinsoul/opencode-autorecord.git"
    },
    "homepage": "https://github.com/kevinsoul/opencode-autorecord/#readme",
    "bugs": {
        "url": "https://github.com/kevinsoul/opencode-autorecord//issues"
    },
    "dependencies": {
        "@opencode-ai/plugin": "^1.14.19",
        "@opencode-ai/sdk": "^1.14.19"
    },
    "devDependencies": {
        "@types/node": "^22.0.0",
        "@typescript-eslint/eslint-plugin": "^8.0.0",
        "@typescript-eslint/parser": "^8.0.0",
        "eslint": "^9.0.0",
        "tsup": "^8.0.0",
        "typescript": "^5.8.0",
        "typescript-eslint": "^8.54.0"
    },
    "engines": {
        "node": ">=18.0.0"
    }
}
